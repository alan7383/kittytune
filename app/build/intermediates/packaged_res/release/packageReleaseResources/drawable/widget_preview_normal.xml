<?xml version="1.0" encoding="utf-8"?>
    <layer-list xmlns:android="http://schemas.android.com/apk/res/android">
        <!-- Fond principal du widget (couleur de surface) -->
        <item>
            <shape android:shape="rectangle">
                <solid android:color="#FFFBFE" /> <!-- Couleur de surface claire -->
                <corners android:radius="28dp" />
            </shape>
        </item>
    
        <!-- Pochette d'album à gauche -->
        <item
            android:width="110dp"
            android:height="110dp"
            android:left="12dp"
            android:gravity="center_vertical|left">
            <shape android:shape="rectangle">
                <solid android:color="#E7E0EC" /> <!-- Couleur surface-variant -->
                <corners android:radius="16dp" />
            </shape>
        </item>
        <item
            android:width="48dp"
            android:height="48dp"
            android:left="43dp"
            android:gravity="center_vertical">
            <bitmap android:src="@drawable/ic_notification" android:tint="#49454F" />
        </item>
    
    
        <!-- Section droite avec textes et contrôles -->
        <!-- Placeholder pour le titre -->
        <item
            android:width="120dp"
            android:height="12dp"
            android:left="138dp"
            android:top="24dp">
            <shape android:shape="rectangle">
                <solid android:color="#1C1B1F" />
                <corners android:radius="6dp"/>
            </shape>
        </item>
        <!-- Placeholder pour l'artiste -->
        <item
            android:width="80dp"
            android:height="10dp"
            android:left="138dp"
            android:top="42dp">
            <shape android:shape="rectangle">
                <solid android:color="#49454F" />
                <corners android:radius="5dp"/>
            </shape>
        </item>
    
        <!-- Bouton Play/Pause (grand cercle) -->
        <item
            android:width="48dp"
            android:height="48dp"
            android:gravity="center"
            android:left="20dp">
            <shape android:shape="oval">
                <solid android:color="#EADDFF" /> <!-- Couleur primary-container -->
            </shape>
        </item>
        <item
            android:width="28dp"
            android:height="28dp"
            android:gravity="center"
            android:left="20dp">
            <bitmap android:src="@drawable/ic_play_arrow" android:tint="#21005D" />
        </item>
    
        <!-- Bouton Précédent -->
        <item
            android:width="32dp"
            android:height="32dp"
            android:gravity="center"
            android:right="30dp">
            <bitmap android:src="@drawable/ic_skip_previous" android:tint="#1C1B1F" />
        </item>
    
        <!-- Bouton Suivant -->
        <item
            android:width="32dp"
            android:height="32dp"
            android:gravity="center"
            android:left="70dp">
            <bitmap android:src="@drawable/ic_skip_next" android:tint="#1C1B1F" />
        </item>
    </layer-list>


