<?xml version="1.0" encoding="utf-8"?>
    <layer-list xmlns:android="http://schemas.android.com/apk/res/android">
        <!-- Fond en forme de pilule (couleur surface) -->
        <item>
            <shape android:shape="rectangle">
                <solid android:color="#FFFBFE" />
                <corners android:radius="32dp" />
            </shape>
        </item>
    
        <!-- Pochette d'album (cercle à gauche) -->
        <item
            android:width="56dp"
            android:height="56dp"
            android:left="8dp"
            android:gravity="center_vertical|left">
            <shape android:shape="oval">
                <solid android:color="#E7E0EC" />
            </shape>
        </item>
        <item
            android:width="24dp"
            android:height="24dp"
            android:left="24dp"
            android:gravity="center_vertical">
            <bitmap android:src="@drawable/ic_notification" android:tint="#49454F"/>
        </item>
    
        <!-- Placeholder textes -->
        <item
            android:width="80dp"
            android:height="10dp"
            android:left="76dp"
            android:top="22dp">
            <shape android:shape="rectangle">
                <solid android:color="#1C1B1F" />
                <corners android:radius="5dp"/>
            </shape>
        </item>
        <item
            android:width="50dp"
            android:height="8dp"
            android:left="76dp"
            android:top="38dp">
            <shape android:shape="rectangle">
                <solid android:color="#49454F" />
                <corners android:radius="4dp"/>
            </shape>
        </item>
    
        <!-- Bouton Play (cercle rempli à droite) -->
        <item
            android:width="44dp"
            android:height="44dp"
            android:right="58dp"
            android:gravity="center_vertical|right">
            <shape android:shape="oval">
                <solid android:color="#EADDFF" />
            </shape>
        </item>
        <item
            android:width="24dp"
            android:height="24dp"
            android:right="68dp"
            android:gravity="center_vertical|right">
            <bitmap android:src="@drawable/ic_play_arrow" android:tint="#21005D"/>
        </item>
    
        <!-- Boutons Précédent/Suivant (icônes simples) -->
        <item
            android:width="28dp"
            android:height="28dp"
            android:right="102dp"
            android:gravity="center_vertical|right">
            <bitmap android:src="@drawable/ic_skip_previous" android:tint="#49454F"/>
        </item>
        <item
            android:width="28dp"
            android:height="28dp"
            android:right="18dp"
            android:gravity="center_vertical|right">
            <bitmap android:src="@drawable/ic_skip_next" android:tint="#49454F"/>
        </item>
    </layer-list>


