---
interface Props {
  title: string;
  description: string;
  icon: string;
  iconColor?: string;
}

const { title, description, icon, iconColor = "var(--md-sys-color-primary)" } = Astro.props;
---

<div style="display: flex; flex-direction: column; justify-content: space-between; background: rgba(255,255,255,0.02); padding: 12px 16px; border-radius: 16px; border: 1px solid rgba(255,255,255,0.05);">
  <div style="display: flex; align-items: flex-start; justify-content: space-between;">
    <div style="font-weight: 600; font-size: 0.95rem; color: var(--md-sys-color-on-surface);">{title}</div>
    <span class="material-icons-round" style={`color: ${iconColor}; font-size: 1.2rem;`}>{icon}</span>
  </div>
  <div style="font-size: 0.75rem; color: var(--md-sys-color-outline); margin-top: 4px; line-height: 1.3;" set:html={description}></div>
</div>
