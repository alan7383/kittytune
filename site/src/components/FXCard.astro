---
interface Props {
  title: string;
  description: string;
  icon: string;
  iconColor?: string;
}

const { title, description, icon, iconColor = "var(--md-sys-color-primary)" } = Astro.props;
---

<div class="fx-card">
  <div class="fx-card-header">
    <div class="fx-card-title">{title}</div>
    <span class="material-icons-round fx-card-icon" style={`color: ${iconColor};`}>{icon}</span>
  </div>
  <div class="fx-card-desc" set:html={description}></div>
</div>
