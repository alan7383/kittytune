---
interface Props {
  title: string;
  description: string;
  icon: string;
  iconColor?: string;
}

const { title, description, icon, iconColor = "var(--md-sys-color-primary)" } = Astro.props;
---

<div class="fx-card">
  <div class="fx-card-header">
    <div class="fx-card-title">{title}</div>
    <span class="material-icons-round fx-card-icon" style={`color: ${iconColor};`}>{icon}</span>
  </div>
  <div class="fx-card-desc" set:html={description}></div>
</div>

<style>
  .fx-card {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    background: var(--card-icon-bg);
    padding: 12px 16px;
    border-radius: 16px;
    border: 1px solid var(--panel-border);
  }

  .fx-card-header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
  }

  .fx-card-title {
    font-weight: 600;
    font-size: 0.95rem;
    color: var(--md-sys-color-on-surface);
  }

  .fx-card-icon {
    font-size: 1.2rem;
  }

  .fx-card-desc {
    font-size: 0.75rem;
    color: var(--md-sys-color-outline);
    margin-top: 4px;
    line-height: 1.3;
  }
</style>
