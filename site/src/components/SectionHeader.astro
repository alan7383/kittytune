---
interface Props {
  eyebrow?: string;
  eyebrowIcon?: string;
  title: string;
  description?: string;
  class?: string;
  centered?: boolean;
}

const { eyebrow, eyebrowIcon, title, description, class: className = "", centered = false } = Astro.props;
---
<div class={`section-header reveal ${centered ? 'centered' : ''} ${className}`}>
  { eyebrow ? (
    <div>
      <span class="eyebrow">
        {eyebrowIcon && <span class="material-icons-round">{eyebrowIcon}</span>}
        {eyebrow}
      </span>
      <h2 set:html={title}></h2>
      {description && <p set:html={description}></p>}
    </div>
  ) : (
    <>
      <h2 class={className.includes('headline-large') ? 'headline-large' : ''} set:html={title}></h2>
      {description && <p set:html={description}></p>}
    </>
  )}
</div>
