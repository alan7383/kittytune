---
// site/src/components/BentoPanel.astro
interface Props {
  id?: string;
  title?: string;
  description?: string;
  icon?: string;
  iconColor?: string;
  class?: string;
  style?: string;
}

const { id, title, description, icon, iconColor, class: className = "", style = "" } = Astro.props;
---

<div id={id} class={`bento-panel ${className}`} style={style}>
  {Astro.slots.has('header') ? (
    <slot name="header" />
  ) : (
    <>
      {title && (
        <h3 class="panel-title">
          {icon && <span class="material-icons-round" style={`color: ${iconColor || 'inherit'};`}>{icon}</span>}
          {title}
        </h3>
      )}
      {description && <p class="panel-desc" set:html={description}></p>}
    </>
  )}
  
  <slot />
</div>
