---
import LogoMark from './LogoMark.astro';
import { SITE } from '../config/site';
---

<footer>
  <div class="container">
    <div class="footer-grid">
      <div class="footer-brand">
        <LogoMark class="footer-logo-svg" />
        <h4><span>kittytune</span> ( &gt; . &lt; )</h4>
        <p style="color: var(--md-sys-color-on-surface-variant); font-size: 0.95rem;">
          Made by <strong style="color: var(--md-sys-color-primary);">alan7383</strong>.<br>
        </p>
      </div>
      <div class="footer-col">
        <h5>Links</h5>
        <ul>
          <li><a href={SITE.github}>GitHub</a></li>
          <li><a href={SITE.releases}>Releases</a></li>
        </ul>
      </div>
      <div class="footer-col">
        <h5>Download</h5>
        <ul>
          <li><a href="#" class="latest-download-link">APK (Latest)</a></li>
          <li><a href={SITE.issues}>Report Issue</a></li>
        </ul>
      </div>
    </div>
    <div style="text-align: center; color: var(--md-sys-color-outline); font-size: 0.8rem; margin-top: 40px; opacity: 0.6;">
      GPL-3.0 License &bull; 2026 &bull; ( &gt; . &lt; )
    </div>
  </div>
</footer>
