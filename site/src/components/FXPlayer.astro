---
import MaterialSwitch from './MaterialSwitch.astro';
---

<fx-player>
  <div class="fx-player-box flex items-center gap-24">
    <button id="live-fx-play-btn" class="play-fab-large m-0 flex-shrink-0">
      <span class="material-icons-round text-3xl" id="live-fx-play-icon">play_arrow</span>
    </button>
    <div class="flex-grow flex-col">
      <div class="flex justify-between font-mono text-xs text-outline mb-8">
        <span id="fx-time-current">0:00</span>
        <span id="fx-time-total" class="opacity-50">0:00</span>
      </div>
      <div class="m3-v3-slider fx-progress-bar" id="fx-progress-container" style="height: 32px; --val: 0;">
        <input type="range" id="fx-progress-slider" min="0" max="1" step="0.001" value="0" />
        <div class="m3-v3-layout">
          <div class="m3-v3-track-active" style="height: 18px; border-radius: 6px 1px 1px 6px;"></div>
          <div class="m3-v3-thumb-container" style="height: 32px; flex: 0 0 10px;">
            <div class="m3-v3-thumb" style="height: 32px; width: 3px; border-radius: 1.5px;"></div>
          </div>
          <div class="m3-v3-track-inactive" style="height: 18px; border-radius: 1px 6px 6px 1px;"></div>
        </div>
      </div>
    </div>
  </div>
  <div class="fx-switches-grid">
    <MaterialSwitch id="toggle-8d" title="8D Spatial" description="Revolving LFO panning" />
    <MaterialSwitch id="toggle-nightcore" title="Nightcore" description="Pitch and speed up" />
    <MaterialSwitch id="toggle-reverb" title="Slowed + Reverb" description="Slower playback with rich echo" />
    <MaterialSwitch id="toggle-muffled" title="Muffled" description="Outside the club feels" />
  </div>
</fx-player>

<script>
  import { isPlaying, offsetTime, activeEffects } from '../scripts/audio-store';
  import { togglePlayback, getCurrentTime, getDuration, setOffset, start8D, stop8D, updateEffectValues, loadAudio, startPlayback, pauseAudio } from '../scripts/audio-service';

  let progressDrag = false;
  let lastRenderId: number | null = null;

  const updateUITotalTime = () => {
    const timeTotal = document.getElementById('fx-time-total');
    const duration = getDuration();
    if (timeTotal && duration > 0) {
      let minutes = Math.floor(duration / 60);
      let seconds = Math.floor(duration % 60).toString().padStart(2, '0');
      timeTotal.textContent = `${minutes}:${seconds}`;
    }
  };

  const updateProgress = () => {
    if (!isPlaying.get()) return;
    if (!progressDrag) {
      const current = getCurrentTime();
      const duration = getDuration();
      if (duration > 0) {
        const percent = current / duration;
        const pSlider = document.getElementById('fx-progress-slider') as HTMLInputElement;
        const pCont = document.getElementById('fx-progress-container');
        const tCurr = document.getElementById('fx-time-current');
        if (pSlider && pCont && tCurr) {
          pSlider.value = percent.toString();
          pCont.style.setProperty('--val', percent.toString());
          let minutes = Math.floor(current / 60);
          let seconds = Math.floor(current % 60).toString().padStart(2, '0');
          tCurr.textContent = `${minutes}:${seconds}`;
        }
      }
    }
    lastRenderId = requestAnimationFrame(updateProgress);
  };

  class FxPlayer extends HTMLElement {
    unsubisPlaying!: () => void;
    unsubactiveEffects!: () => void;
    unsuboffsetTime!: () => void;
    private abortController = new AbortController();

    connectedCallback() {
      this.attachListeners();
      
      this.unsubisPlaying = isPlaying.subscribe((playing) => {
        const playIcon = document.getElementById('live-fx-play-icon');
        if (playIcon) playIcon.textContent = playing ? 'pause' : 'play_arrow';
        if (playing) {
          updateProgress();
        } else if (lastRenderId) {
          cancelAnimationFrame(lastRenderId);
        }
      });
      
      this.unsubactiveEffects = activeEffects.subscribe((effects) => {
        const t8d = document.getElementById('toggle-8d') as HTMLInputElement;
        const tnc = document.getElementById('toggle-nightcore') as HTMLInputElement;
        const trv = document.getElementById('toggle-reverb') as HTMLInputElement;
        const tmf = document.getElementById('toggle-muffled') as HTMLInputElement;
        
        if (t8d) {
          t8d.checked = effects['8d'];
          tnc.checked = effects['nightcore'];
          trv.checked = effects['reverb'];
          tmf.checked = effects['muffled'];
        }
      });

      this.unsuboffsetTime = offsetTime.subscribe((time) => {
        const duration = getDuration();
        if (duration > 0) {
          const pSlider = document.getElementById('fx-progress-slider') as HTMLInputElement;
          const pCont = document.getElementById('fx-progress-container');
          const tCurr = document.getElementById('fx-time-current');
          
          if (pSlider && pCont && tCurr && !progressDrag) {
            const percent = time / duration;
            pSlider.value = percent.toString();
            pCont.style.setProperty('--val', percent.toString());
            
            let minutes = Math.floor(time / 60);
            let seconds = Math.floor(time % 60).toString().padStart(2, '0');
            tCurr.textContent = `${minutes}:${seconds}`;
          }
        }
      });

      // Load audio if not loaded
      if (getDuration() === 0) {
        loadAudio().then(() => {
          updateUITotalTime();
        });
      } else {
        updateUITotalTime();
        if (isPlaying.get()) {
          updateProgress();
        }
      }
    }

    disconnectedCallback() {
      if (this.unsubisPlaying) this.unsubisPlaying();
      if (this.unsubactiveEffects) this.unsubactiveEffects();
      if (this.unsuboffsetTime) this.unsuboffsetTime();
      if (lastRenderId) cancelAnimationFrame(lastRenderId);
      this.abortController.abort();
    }

    attachListeners() {
      const playBtn = this.querySelector('#live-fx-play-btn');
      if (playBtn) {
        playBtn.addEventListener('click', togglePlayback, { signal: this.abortController.signal });
      }
      
      const effects = ['8d', 'nightcore', 'reverb', 'muffled'] as const;
      effects.forEach(fx => {
        const el = this.querySelector(`#toggle-${fx}`) as HTMLInputElement;
        if (el) {
          el.addEventListener('change', () => {
            activeEffects.setKey(fx, el.checked);
            if (fx === '8d') {
              if (isPlaying.get()) {
                if (el.checked) start8D();
                else stop8D();
              }
            } else {
              updateEffectValues();
            }
          }, { signal: this.abortController.signal });
        }
      });

      const pSlider = this.querySelector('#fx-progress-slider') as HTMLInputElement;
      if (pSlider) {
        pSlider.addEventListener('mousedown', () => {
          progressDrag = true;
          this.querySelector('#fx-progress-container')?.classList.add('is-dragging');
        }, { signal: this.abortController.signal });
        
        pSlider.addEventListener('touchstart', () => {
          progressDrag = true;
          this.querySelector('#fx-progress-container')?.classList.add('is-dragging');
        }, { passive: true, signal: this.abortController.signal });
        
        window.addEventListener('mouseup', () => {
          this.querySelector('#fx-progress-container')?.classList.remove('is-dragging');
        }, { signal: this.abortController.signal });
        
        window.addEventListener('touchend', () => {
          this.querySelector('#fx-progress-container')?.classList.remove('is-dragging');
        }, { signal: this.abortController.signal });
        
        pSlider.addEventListener('input', () => {
          let val = parseFloat(pSlider.value);
          const pCont = this.querySelector('#fx-progress-container') as HTMLElement;
          const tCurr = this.querySelector('#fx-time-current');
          const duration = getDuration();
          if (pCont) pCont.style.setProperty('--val', val.toString());
          if (duration > 0 && tCurr) {
            let current = val * duration;
            let minutes = Math.floor(current / 60);
            let seconds = Math.floor(current % 60).toString().padStart(2, '0');
            tCurr.textContent = `${minutes}:${seconds}`;
          }
        }, { signal: this.abortController.signal });
        
        pSlider.addEventListener('change', () => {
          const duration = getDuration();
          if (duration > 0) {
            if (isPlaying.get()) {
              pauseAudio();
              setOffset(parseFloat(pSlider.value) * duration);
              startPlayback();
            } else {
              setOffset(parseFloat(pSlider.value) * duration);
            }
          }
          progressDrag = false;
        }, { signal: this.abortController.signal });
      }
    }
  }

  customElements.define('fx-player', FxPlayer);
</script>

<style>
  .m3-v3-slider {
    position: relative;
    width: 100%;
    height: 52px;
    display: flex;
    align-items: center;
  }
  .m3-v3-slider input[type="range"] {
    position: absolute;
    inset: 0;
    z-index: 10;
    width: 100%;
    height: 100%;
    opacity: 0;
    cursor: pointer;
    margin: 0;
  }
  .m3-v3-layout {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    pointer-events: none;
  }
  .m3-v3-track-active {
    flex: var(--val, 0.5);
    height: 40px;
    background: var(--md-sys-color-primary);
    border-radius: 12px 4px 4px 12px;
    transition: flex 0.3s var(--ease-expressive), background-color 0.2s;
  }
  .m3-v3-thumb-container {
    flex: 0 0 16px;
    height: 52px;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .m3-v3-thumb {
    width: 4px;
    height: 52px;
    border-radius: 2px;
    background: var(--md-sys-color-primary);
    transition: transform 0.2s var(--ease-expressive), background-color 0.2s;
  }
  .m3-v3-track-inactive {
    position: relative;
    flex: calc(1 - var(--val, 0.5));
    height: 40px;
    background: rgba(255, 255, 255, 0.12);
    border-radius: 4px 12px 12px 4px;
    overflow: hidden;
    transition: flex 0.3s var(--ease-expressive);
  }
  .m3-v3-track-inactive::after {
    content: "";
    position: absolute;
    right: 12px;
    top: 50%;
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: var(--md-sys-color-primary);
    transform: translateY(-50%);
    transition: opacity 0.2s;
  }
  .m3-v3-slider:hover .m3-v3-track-inactive::after, 
  .m3-v3-slider.is-dragging .m3-v3-track-inactive::after {
    opacity: 0;
  }
  .m3-v3-slider.no-transition .m3-v3-track-active, 
  .m3-v3-slider.no-transition .m3-v3-track-inactive {
    transition: none;
  }
  .m3-v3-slider.is-dragging .m3-v3-thumb {
    transform: scaleY(1.05) scaleX(0.8);
  }

  /* Mode clair */
  :global(.light-mode) .m3-v3-track-inactive {
    background: rgba(0, 0, 0, 0.1);
  }

  /* Utility classes used in template */
  .flex { display: flex; }
  .items-center { align-items: center; }
  .gap-24 { gap: 24px; }
  .flex-grow { flex-grow: 1; }
  .flex-col { flex-direction: column; }
  .justify-between { justify-content: space-between; }
  .font-mono { font-family: monospace; }
  .text-xs { font-size: 0.75rem; }
  .text-outline { color: var(--md-sys-color-outline); }
  .mb-8 { margin-bottom: 8px; }
  .opacity-50 { opacity: 0.5; }
  .m-0 { margin: 0; }
  .flex-shrink-0 { flex-shrink: 0; }
  .text-3xl { font-size: 1.875rem; }
</style>
