---
interface Props {
  id: string;
  min?: number;
  max?: number;
  value?: number;
  step?: number | string;
  label?: string;
  icon?: string;
  outputId?: string;
  axis?: string;
  containerClass?: string;
  sliderClass?: string;
  containerId?: string;
  'aria-label'?: string;
}

const { 
  id, 
  min = 0, 
  max = 100, 
  value = 50, 
  step = 1, 
  label, 
  icon, 
  outputId, 
  axis, 
  containerClass = "",
  sliderClass = "",
  containerId,
  'aria-label': ariaLabel
} = Astro.props;

// Calcul de la valeur initiale pour le rendu CSS
const initialVal = (value - min) / (max - min);
---
<m3-slider data-axis={axis} data-min={min} data-max={max}>
  <div class={`m3-range-wrapper ${containerClass}`} id={containerId}>
    { (label || icon || outputId) && (
      <div class="m3-range-info">
        <span>
          {icon && <span class="material-icons-round">{icon}</span>}
          {label}
        </span>
        {outputId && <output id={outputId}>{value}</output>}
      </div>
    )}
    <div class={`m3-v3-slider ${sliderClass}`} data-slider-root data-axis={axis} id={containerId ? undefined : `${id}-container`} style={`--val: ${initialVal};`}>
      <input id={id} type="range" data-slider-input min={min} max={max} value={value} step={step} aria-label={ariaLabel || label} />
      <div class="m3-v3-layout">
        <div class="m3-v3-track-active"></div>
        <div class="m3-v3-thumb-container">
          <div class="m3-v3-thumb"></div>
        </div>
        <div class="m3-v3-track-inactive"></div>
      </div>
    </div>
  </div>
</m3-slider>

<script>
  class M3SliderElement extends HTMLElement {
    private abortController = new AbortController();

    connectedCallback() {
      const input = this.querySelector('[data-slider-input]') as HTMLInputElement;
      const sliderRoot = this.querySelector('[data-slider-root]') as HTMLElement;
      const output = this.querySelector('output') as HTMLOutputElement;
      
      const min = parseFloat(this.dataset.min || '0');
      const max = parseFloat(this.dataset.max || '100');

      input.addEventListener('input', () => {
        const val = parseFloat(input.value);
        const percent = (val - min) / (max - min);
        sliderRoot.style.setProperty('--val', percent.toString());
        
        if (output) {
          output.textContent = input.value;
        }
        
        this.dispatchEvent(new CustomEvent('m3-change', { 
          detail: { axis: this.dataset.axis, value: val },
          bubbles: true 
        }));
      }, { signal: this.abortController.signal });

      input.addEventListener('pointerdown', () => sliderRoot.classList.add('is-dragging'), { signal: this.abortController.signal });
      window.addEventListener('pointerup', () => sliderRoot.classList.remove('is-dragging'), { signal: this.abortController.signal });
    }

    disconnectedCallback() {
      this.abortController.abort();
    }
  }
  customElements.define('m3-slider', M3SliderElement);
</script>

<style>
  .m3-range-wrapper {
    min-width: 0;
    width: 100%;
  }
  .m3-range-info {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
    margin-bottom: 12px;
    color: var(--md-sys-color-on-surface);
    font-size: 1rem;
    font-weight: 600;
  }
  .m3-range-info span:first-child {
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }
  .m3-range-info output {
    color: var(--md-sys-color-primary);
    font-family: ui-monospace, SFMono-Regular, Consolas, monospace;
  }
  .m3-v3-slider {
    position: relative;
    width: 100%;
    height: 52px;
    display: flex;
    align-items: center;
  }
  .m3-v3-slider input[type="range"] {
    position: absolute;
    inset: 0;
    z-index: 10;
    width: 100%;
    height: 100%;
    opacity: 0;
    cursor: pointer;
    margin: 0;
  }
  .m3-v3-layout {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    pointer-events: none;
  }
  .m3-v3-track-active {
    flex: var(--val, 0.5);
    height: 40px;
    background: var(--md-sys-color-primary);
    border-radius: 12px 4px 4px 12px;
    transition: flex 0.3s var(--ease-expressive), background-color 0.2s;
  }
  .m3-v3-thumb-container {
    flex: 0 0 16px;
    height: 52px;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .m3-v3-thumb {
    width: 4px;
    height: 52px;
    border-radius: 2px;
    background: var(--md-sys-color-primary);
    transition: transform 0.2s var(--ease-expressive), background-color 0.2s;
  }
  .m3-v3-track-inactive {
    position: relative;
    flex: calc(1 - var(--val, 0.5));
    height: 40px;
    background: rgba(255, 255, 255, 0.12);
    border-radius: 4px 12px 12px 4px;
    overflow: hidden;
    transition: flex 0.3s var(--ease-expressive);
  }
  .m3-v3-track-inactive::after {
    content: "";
    position: absolute;
    right: 12px;
    top: 50%;
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: var(--md-sys-color-primary);
    transform: translateY(-50%);
    transition: opacity 0.2s;
  }
  .m3-v3-slider:hover .m3-v3-track-inactive::after, 
  .m3-v3-slider.is-dragging .m3-v3-track-inactive::after,
  .m3-range-wrapper.is-dragging .m3-v3-track-inactive::after {
    opacity: 0;
  }
  .m3-v3-slider.no-transition .m3-v3-track-active, 
  .m3-v3-slider.no-transition .m3-v3-track-inactive,
  .m3-range-wrapper.no-transition .m3-v3-track-active,
  .m3-range-wrapper.no-transition .m3-v3-track-inactive {
    transition: none;
  }
  .m3-v3-slider.is-dragging .m3-v3-thumb,
  .m3-range-wrapper.is-dragging .m3-v3-thumb {
    transform: scaleY(1.05) scaleX(0.8);
  }

  /* Mode clair */
  :global(.light-mode) .m3-v3-track-inactive {
    background: rgba(0, 0, 0, 0.1);
  }
</style>
