---
interface Props {
  id: string;
  min?: number;
  max?: number;
  value?: number;
  step?: number | string;
  label?: string;
  icon?: string;
  outputId?: string;
  axis?: string;
  containerClass?: string;
  sliderClass?: string;
  containerId?: string;
  'aria-label'?: string;
}

const { 
  id, 
  min = 0, 
  max = 100, 
  value = 50, 
  step = 1, 
  label, 
  icon, 
  outputId, 
  axis, 
  containerClass = "",
  sliderClass = "",
  containerId,
  'aria-label': ariaLabel
} = Astro.props;

// Calcul de la valeur initiale pour le rendu CSS
const initialVal = (value - min) / (max - min);
---
<div class={`m3-range-wrapper ${containerClass}`} id={containerId}>
  { (label || icon || outputId) && (
    <div class="m3-range-info">
      <span>
        {icon && <span class="material-icons-round">{icon}</span>}
        {label}
      </span>
      {outputId && <output id={outputId}>{value}</output>}
    </div>
  )}
  <div class={`m3-v3-slider ${sliderClass}`} data-axis={axis} id={containerId ? undefined : `${id}-container`} style={`--val: ${initialVal};`}>
    <input id={id} type="range" min={min} max={max} value={value} step={step} aria-label={ariaLabel || label} />
    <div class="m3-v3-layout">
      <div class="m3-v3-track-active"></div>
      <div class="m3-v3-thumb-container">
        <div class="m3-v3-thumb"></div>
      </div>
      <div class="m3-v3-track-inactive"></div>
    </div>
  </div>
</div>
