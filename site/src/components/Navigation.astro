---
import LogoMark from './LogoMark.astro';
import { NAV_ITEMS, PLACEHOLDER_NAV_ITEMS } from '../config/site';

const { activePage, variant = 'mobile' } = Astro.props;
---

{variant === 'mobile' ? (
  <>
    <div class="m3-mobile-top-bar">
      <div class="m3-top-bar-left">
        <div class="m3-menu-btn">
          <span class="material-icons-round">menu</span>
        </div>
        <div class="m3-top-bar-title">
          <span>kittytune</span> ( &gt; . &lt; )
        </div>
      </div>
      <div class="m3-menu-btn js-search-btn">
        <span class="material-icons-round">search</span>
      </div>
    </div>

    <div class="m3-drawer-scrim" id="drawer-scrim"></div>
    <aside class="m3-modal-drawer" id="mobile-drawer">
      <div class="m3-drawer-header">KittyTune Navigation</div>
      {NAV_ITEMS.map((item) => (
        <a
          href={`${import.meta.env.BASE_URL}${item.href}`}
          class:list={['m3-drawer-item', { active: activePage === item.key }]}
        >
          <span class="material-icons-round">{item.icon}</span>
          <span>{item.label}</span>
        </a>
      ))}
      <div style="margin-top: auto;">
        <div style="height: 1px; background: var(--md-sys-color-outline-variant); opacity: 0.3; margin: 8px 16px 16px;"></div>
        <a href="#" class="m3-drawer-item theme-toggle-btn">
          <span class="material-icons-round theme-toggle-icon">light_mode</span>
          <span>Toggle Theme</span>
        </a>
        <div style="padding: 12px; opacity: 0.5; font-size: 0.8rem; text-align: center; color: var(--md-sys-color-on-surface);">
          ( &gt; . &lt; ) v
        </div>
      </div>
    </aside>
  </>
) : (
  <aside class="m3-nav-rail">
    <div class="nav-fab js-search-btn">
      <span class="material-icons-round">search</span>
    </div>
    {NAV_ITEMS.map((item) => (
      <a
        href={`${import.meta.env.BASE_URL}${item.href}`}
        class:list={['nav-rail-item', { active: activePage === item.key }]}
      >
        <div class="nav-indicator">
          {item.logo ? <LogoMark class="nav-logo-svg" /> : <span class="material-icons-round nav-icon">{item.icon}</span>}
        </div>
        <span class="nav-label">{item.label}</span>
      </a>
    ))}
    {PLACEHOLDER_NAV_ITEMS.map((item) => (
      <a href="#" class="nav-rail-item js-placeholder-btn" data-message={item.message}>
        <div class="nav-indicator">
          <span class="material-icons-round nav-icon">{item.icon}</span>
        </div>
        <span class="nav-label">{item.label}</span>
      </a>
    ))}
    <div class="nav-spacer"></div>
    <div class="nav-bottom-action js-placeholder-btn" data-message="Mini-player settings are not available yet! ( > . < )">
      <span class="material-icons-round">play_arrow</span>
    </div>
    <div class="nav-bottom-action theme-toggle-btn" title="Toggle Theme">
      <span class="material-icons-round theme-toggle-icon">light_mode</span>
    </div>
  </aside>
)}
