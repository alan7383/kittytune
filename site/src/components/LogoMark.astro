---
import { LOGO_PATH } from '../config/paths';
const { class: className = '', title = 'KittyTune logo' } = Astro.props;
---

<svg 
  class={className} 
  viewBox="260 360 510 310" 
  xmlns="http://www.w3.org/2000/svg" 
  aria-label={title}
>
  <!-- Le transform déplace le dessin pour le centrer parfaitement dans la viewBox ci-dessus -->
  <g transform="translate(17, -25)">
    <path d={LOGO_PATH} fill="currentColor" />
  </g>
</svg>

<style>
  svg {
    /* Assure que le logo garde ses proportions */
    height: auto;
    display: block;
  }
</style>
