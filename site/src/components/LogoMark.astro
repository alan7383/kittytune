---
import { LOGO_PATH } from '../config/paths';
const { class: className = '', title = 'KittyTune logo' } = Astro.props;
const pathData = LOGO_PATH;
---

<svg class={className} viewBox="0 0 1024 1024" xmlns="http://www.w3.org/2000/svg" aria-label={title}>
  <g transform="translate(17, -25)">
    <path d={pathData} fill="currentColor" />
  </g>
</svg>
