---
interface Props {
  id: string;
  title: string;
  description: string;
  checked?: boolean;
}

const { id, title, description, checked = false } = Astro.props;
---

<label class="md3-switch">
  <div class="md3-switch-label-container">
    <span class="md3-switch-title">{title}</span>
    <span class="md3-switch-desc">{description}</span>
  </div>
  <input type="checkbox" id={id} class="md3-switch-input" checked={checked} />
  <div class="md3-switch-track">
    <div class="md3-switch-thumb">
      <div class="md3-switch-icon md3-switch-icon-cross">
        <svg viewBox="0 0 12 12" width="10" height="10">
          <path d="M2 2L10 10M10 2L2 10" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path>
        </svg>
      </div>
      <div class="md3-switch-icon md3-switch-icon-check">
        <svg viewBox="0 0 12 12" width="10" height="10">
          <path d="M2 6L5 9L10 3" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"></path>
        </svg>
      </div>
    </div>
  </div>
</label>
