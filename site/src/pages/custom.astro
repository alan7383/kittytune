---
import SiteLayout from '../layouts/SiteLayout.astro';
import { PAGES } from '../config/site';
import SettingsSwitch from '../components/SettingsSwitch.astro';
import M3Slider from '../components/M3Slider.astro';
import SectionHeader from '../components/SectionHeader.astro';
import '../styles/pages/custom.css';
---

<SiteLayout page={PAGES.custom}>
  <div class="custom-page">
    <section class="custom-hero">
      <div class="container hero-grid">
        <div class="hero-copy reveal">
          <span class="eyebrow"><span class="material-icons-round">tune</span> Material 3 Expressive studio</span>
          <h1>Make KittyTune feel like your phone, your music, your hands.</h1>
          <p>
            A live design surface for the real customization features in the Android app:
            Google Sans Flex axes, Monet color seeds, full player background modes, and Glance widgets.
          </p>
          <div class="hero-actions">
            <button class="btn btn-primary" id="randomize-all-btn">
              <span class="material-icons-round">auto_fix_high</span>
              Surprise me
            </button>
            <a class="btn btn-tonal" href="#widgets-showcase">
              <span class="material-icons-round">widgets</span>
              View widgets
            </a>
          </div>
        </div>
        <div class="lab-panel hero-lab reveal" id="typography-lab">
          <div class="lab-topbar">
            <div class="lab-title">
              <div class="lab-icon">
                <span class="material-icons-round">draw</span>
              </div>
              <div>
                <h2>Typography Lab</h2>
                <p>Google Sans Flex, live on every Material text role.</p>
              </div>
            </div>
            <button class="axis-chip" id="typo-autoplay-btn" aria-label="Toggle autoplay">
              <span class="material-icons-round" id="typo-autoplay-icon">pause</span> Auto play
            </button>
          </div>
          <div class="type-preview-wrap">
            <div class="type-preview" id="type-preview">
              <span id="dynamic-font-text">Breakcore</span>
              <small>Headlines, labels, player titles and settings rows inherit the same variable font engine.</small>
            </div>
          </div>
          <div class="preset-row p-8-6 ml-n6" id="preset-row" aria-label="Typography presets">
            <button class="preset-chip active" data-preset="default">Default</button>
            <button class="preset-chip" data-preset="rounded">Rounded</button>
            <button class="preset-chip" data-preset="elegant">Elegant</button>
            <button class="preset-chip" data-preset="chunky">Chunky</button>
            <button class="preset-chip" data-preset="compact">Compact</button>
            <button class="preset-chip" data-preset="slanted">Slanted</button>
            <button class="preset-chip" data-preset="playful">Playful</button>
            <button class="preset-chip" data-preset="wide">Wide</button>
          </div>
          <div class="slider-bank">
            <M3Slider id="axis-wght" min={100} max={1000} value={620} step={1} axis="wght" label="Weight" icon="line_weight" outputId="out-wght" sliderClass="lab-slider" />
            <M3Slider id="axis-wdth" min={25} max={151} value={104} step={1} axis="wdth" label="Width" icon="width_full" outputId="out-wdth" sliderClass="lab-slider" />
            <M3Slider id="axis-slnt" min={-10} max={0} value={-2} step={1} axis="slnt" label="Slant" icon="format_italic" outputId="out-slnt" sliderClass="lab-slider" />
            <M3Slider id="axis-rond" min={0} max={100} value={45} step={1} axis="rond" label="Roundness" icon="radio_button_checked" outputId="out-rond" sliderClass="lab-slider" />
            <M3Slider id="axis-grad" min={-200} max={150} value={0} step={1} axis="grad" label="Grade" icon="contrast" outputId="out-grad" sliderClass="lab-slider" />
            <M3Slider id="axis-opsz" min={8} max={144} value={32} step={1} axis="opsz" label="Optical size" icon="visibility" outputId="out-opsz" sliderClass="lab-slider" />
          </div>
        </div>
      </div>
    </section>
    <section class="section" id="discord-rpc">
      <div class="container">
        <SectionHeader 
          eyebrow="Discord Rich Presence" 
          eyebrowIcon="sports_esports" 
          title="Show off your taste, live on your profile." 
          description="KittyTune natively connects to your Discord status. Choose exactly how your current track appears to your friends." 
        />
        <div class="player-grid">
          <div class="discord-preview-panel reveal">
            <div class="discord-profile-card">
              <div class="discord-banner"></div>
              <div class="discord-profile-body">
                <div class="discord-avatar">
                  <img src="https://avatars.githubusercontent.com/u/75907296?v=4" alt="Avatar" />
                </div>
                <div class="discord-user-info">
                  <div class="discord-username">alananasssss</div>
                </div>
                <div id="discord-activity-wrap" class="transition-spring transform-top-left">
                  <div class="discord-activity-header">Listening to KittyTune</div>
                  <div class="discord-activity-body">
                    <div class="discord-asset">
                      <img src="https://i1.sndcdn.com/artworks-6o699KkKNS25gzyG-Qv7uzQ-t500x500.jpg" alt="Album Art" />
                      <div class="discord-asset-small">
                        <div class="inner-icon"></div>
                      </div>
                    </div>
                    <div class="discord-info">
                      <div class="discord-title" id="rpc-title">KittyTune</div>
                      <div class="discord-details" id="rpc-details">METAMORPHOSIS</div>
                      <div class="discord-state" id="rpc-state">by INTERWORLD</div>
                      <div class="discord-time">01:24 elapsed</div>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>
          <div class="app-style-panel reveal">
            <h4 class="mb-16 text-primary text-lg">Status Display Mode</h4>
            <div class="preset-row p-8-6 ml-n6 mb-32 justify-start" id="discord-rpc-switcher">
              <button class="preset-chip active" data-mode="ACTIVITY"><span class="material-icons-round text-lg mr-6 v-middle">album</span>Activity</button>
              <button class="preset-chip" data-mode="SONG"><span class="material-icons-round text-lg mr-6 v-middle">music_note</span>Song</button>
              <button class="preset-chip" data-mode="ARTIST"><span class="material-icons-round text-lg mr-6 v-middle">person</span>Artist</button>
            </div>
            <h4 class="mb-16 text-primary text-lg">Integration</h4>
            <div class="compose-settings-group">
              <SettingsSwitch 
                id="rpc-toggle" 
                title="Enable Discord RPC" 
                description="Broadcast playback via local socket" 
                icon="link" 
                checked 
                class="top bottom single"
              />
            </div>
          </div>
        </div>
      </div>
    </section>
    <section class="section" id="player-style">
      <div class="container">
        <SectionHeader 
          eyebrow="Player Style Switcher" 
          eyebrowIcon="smart_display" 
          title="One player, three emotional backgrounds." 
        />
        <div class="player-grid">
          <div class="player-preview-panel reveal">
            <div class="premium-player-card" id="style-player" data-style="theme" style="--pp-cover: url('https://i1.sndcdn.com/artworks-6o699KkKNS25gzyG-Qv7uzQ-t500x500.jpg');">
              <div class="pp-bg" style="background-image: var(--pp-cover);"></div>
              <div class="pp-art-container">
                <div class="pp-art">
                  <img src="https://i1.sndcdn.com/artworks-6o699KkKNS25gzyG-Qv7uzQ-t500x500.jpg" alt="Album Art" />
                </div>
                <div class="pp-lyrics">
                  <div class="pp-lyrics-inner" id="pp-lyrics-inner">
                  </div>
                </div>
              </div>
              <div class="pp-meta">
                <h3>METAMORPHOSIS</h3>
                <p>INTERWORLD</p>
              </div>
              <div class="pp-progress">
                <div class="pp-progress-bar"></div>
              </div>
              <div class="pp-controls">
                <button class="pp-btn"><span class="material-icons-round">skip_previous</span></button>
                <button class="pp-btn pp-btn-play" id="style-play"><span class="material-icons-round">pause</span></button>
                <button class="pp-btn"><span class="material-icons-round">skip_next</span></button>
              </div>
            </div>
          </div>
          <div class="app-style-panel reveal">
            <h4 class="mb-16 text-primary text-lg">Background Mode</h4>
            <div class="preset-row p-8-6 ml-n6 mb-32 justify-start" id="style-switcher">
              <button class="preset-chip" data-style="blur"><span class="material-icons-round text-lg mr-6 v-middle">blur_on</span>Blur</button>
              <button class="preset-chip" data-style="gradient"><span class="material-icons-round text-lg mr-6 v-middle">gradient</span>Gradient</button>
              <button class="preset-chip active" data-style="theme"><span class="material-icons-round text-lg mr-6 v-middle">format_color_fill</span>Theme</button>
            </div>
            <h4 class="mb-16 text-primary text-lg">Options</h4>
            <div class="compose-settings-group">
              <SettingsSwitch 
                id="toggle-inline-lyrics" 
                title="Inline lyrics" 
                description="Synchronized text view" 
                icon="lyrics" 
                class="top"
              />
              <SettingsSwitch 
                id="smart-autoplay" 
                title="Smart Auto-play" 
                description="Endless radio when queue ends" 
                icon="all_inclusive" 
                class="middle"
              />
              <SettingsSwitch 
                id="pure-black-toggle" 
                title="Pure black ready" 
                description="AMOLED pixel saving mode" 
                icon="contrast" 
                class="bottom"
              />
            </div>
          </div>
        </div>
      </div>
    </section>
    <section class="section" id="monet-engine">
      <div class="container">
        <SectionHeader 
          eyebrow="Monet Engine" 
          eyebrowIcon="palette" 
          title="Color seeds that rewrite the whole interface." 
        />
        <div class="monet-studio reveal">
          <div class="monet-grid">
            <div class="monet-controls">
              <div class="monet-controls-group">
                <h3>Theme colors applied to UI</h3>
                <div class="monet-swatches" id="color-grid">
                  <button class="color-swatch active" data-color="#d0bcff" title="Default">
                    <div class="color-swatch-inner" style="background: conic-gradient(from 270deg, #d0bcff 0 180deg, #efb8c8 180deg 270deg, #4f378b 270deg 360deg);"></div>
                  </button>
                  <button class="color-swatch" data-color="#2196f3" title="Blue">
                    <div class="color-swatch-inner" style="background: conic-gradient(from 270deg, #d3e3fd 0 180deg, #004a77 180deg 270deg, #0b57d0 270deg 360deg);"></div>
                  </button>
                  <button class="color-swatch" data-color="#4faf50" title="Green">
                    <div class="color-swatch-inner" style="background: conic-gradient(from 270deg, #c4eed0 0 180deg, #006b5f 180deg 270deg, #0f5223 270deg 360deg);"></div>
                  </button>
                  <button class="color-swatch" data-color="#9e9e9e" title="Monochrome">
                    <div class="color-swatch-inner" style="background: conic-gradient(from 270deg, #ffffff 0 180deg, #a6a6a6 180deg 270deg, #5e5e5e 270deg 360deg);"></div>
                  </button>
                  <button class="color-swatch" data-color="#f44336" title="Red">
                    <div class="color-swatch-inner" style="background: conic-gradient(from 270deg, #ffdad6 0 180deg, #93000a 180deg 270deg, #ba1a1a 270deg 360deg);"></div>
                  </button>
                  <button class="color-swatch" data-color="#ff9800" title="Orange">
                    <div class="color-swatch-inner" style="background: conic-gradient(from 270deg, #ffddb3 0 180deg, #5c6300 180deg 270deg, #8c5000 270deg 360deg);"></div>
                  </button>
                  <button class="color-swatch" data-color="#e91e63" title="Pink">
                    <div class="color-swatch-inner" style="background: conic-gradient(from 270deg, #ffd9e2 0 180deg, #8c0032 180deg 270deg, #bc004b 270deg 360deg);"></div>
                  </button>
                </div>
              </div>
              <div class="monet-controls-group mb-0">
                <h3>Palette style</h3>
                <div class="monet-chip-row" id="palette-styles">
                  <button class="monet-chip active" data-style="TonalSpot">TonalSpot</button>
                  <button class="monet-chip" data-style="Vibrant">Vibrant</button>
                  <button class="monet-chip" data-style="Expressive">Expressive</button>
                  <button class="monet-chip" data-style="Monochrome">Monochrome</button>
                </div>
              </div>
              <div class="monet-controls-group mt-32 mb-0">
                <button class="axis-chip monet-surprise-btn p-16-20" id="monet-surprise-btn">
                  <span class="material-icons-round">auto_awesome</span> Generate new palette
                </button>
              </div>
            </div>
            <div class="monet-preview-board">
              <div class="abstract-phone">
                <div class="ap-header">
                  <div class="ap-header-title"></div>
                  <div class="ap-header-icon"></div>
                </div>
                <div class="ap-body">
                  <div class="ap-card-hero"></div>
                  <div class="ap-row">
                    <div class="ap-card-small"></div>
                    <div class="ap-card-small"></div>
                  </div>
                  <div class="ap-card-accent"></div>
                </div>
                <div class="ap-nav">
                  <div class="ap-nav-item active"></div>
                  <div class="ap-nav-item"></div>
                  <div class="ap-nav-item"></div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>
    <section class="section" id="widgets-showcase">
      <div class="container">
        <SectionHeader 
          eyebrow="Widgets Showcase" 
          eyebrowIcon="widgets" 
          title="Glance widgets that keep playback close." 
        />
        <div class="widgets-stage">
          <div class="studio-panel widget-feature reveal">
            <div class="widget-feature-copy">
              <span class="eyebrow"><span class="material-icons-round">graphic_eq</span> Music widget</span>
              <h3>Album art, transport, effects, speed.</h3>
            </div>
            <div class="android-wall">
              <div class="widget-card widget-large">
                <div class="widget-cover">
                  <img src="https://i1.sndcdn.com/artworks-bMzpIMTz4PHwg6ce-XrAmrw-t500x500.jpg" alt="KittyTune cover collage" />
                </div>
                <div class="widget-content">
                  <div class="widget-meta">
                    <div>
                      <strong>Nightmare</strong>
                      <span>plenka</span>
                    </div>
                    <span class="material-icons-round" style="color:#ff4081;">favorite</span>
                  </div>
                  <div class="widget-actions">
                    <span class="material-icons-round">skip_previous</span>
                    <button class="widget-play"><span class="material-icons-round">pause</span></button>
                    <span class="material-icons-round">skip_next</span>
                  </div>
                  <div class="effect-pills">
                    <span class="effect-pill active">BASS</span>
                    <span class="effect-pill active">8D</span>
                    <span class="effect-pill">Muff</span>
                    <span class="effect-pill">Verb</span>
                    <span class="effect-pill">Ptch</span>
                    <span class="effect-pill speed">1.25x</span>
                    <span class="effect-pill speed">2.0x</span>
                  </div>
                </div>
              </div>
              <div class="widget-card widget-mini">
                <div class="widget-cover">
                  <img src="https://i1.sndcdn.com/artworks-0TwSrEL9emw3S7oT-M05MWg-t500x500.jpg" alt="Mini widget cover" />
                </div>
                <div>
                  <strong>Kunteynir - Черная дыра</strong>
                  <span>interboychik &lt;3</span>
                </div>
                <div class="mini-controls">
                  <span class="material-icons-round">skip_previous</span>
                  <button class="widget-play"><span class="material-icons-round">play_arrow</span></button>
                  <span class="material-icons-round">skip_next</span>
                </div>
              </div>
            </div>
          </div>
          <div class="studio-panel widget-feature reveal">
            <div class="widget-feature-copy">
              <span class="eyebrow"><span class="material-icons-round">search</span> Search and config</span>
              <h3>A launcher, plus a tiny FX control room.</h3>
            </div>
            <div class="android-wall">
              <div class="widget-card widget-search">
                <div class="search-field">
                  <span class="material-icons-round">search</span>
                  <strong>Search KittyTune</strong>
                </div>
                <div class="search-logo">
                  <span class="material-icons-round">music_note</span>
                </div>
              </div>
              <div class="widget-config">
                <div class="config-line">
                  <span class="material-icons-round">bolt</span>
                  <strong>8D Spatial</strong>
                  <span class="check-dot">check</span>
                </div>
                <div class="config-line">
                  <span class="material-icons-round">graphic_eq</span>
                  <strong>Bass Boost</strong>
                  <span class="check-dot">check</span>
                </div>
                <div class="config-line">
                  <span class="material-icons-round">speed</span>
                  <strong>Nightcore - 1.35x</strong>
                  <span class="check-dot">check</span>
                </div>
                <div class="config-line">
                  <span class="material-icons-round">add</span>
                  <strong>Create speed pill</strong>
                  <span style="color: var(--md-sys-color-primary); font-weight: 800;">0.5 - 2.0x</span>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>
  </div>
</SiteLayout>


<script>
  import '../scripts/studio.ts';
</script>
