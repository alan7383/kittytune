---
import SiteLayout from '../layouts/SiteLayout.astro';
import { PAGES } from '../config/site';
import content from '../content/pages/custom.html?raw';
const processedContent = content.replace(/src="assets\//g, `src="${import.meta.env.BASE_URL}assets/`);
---

<SiteLayout page={PAGES.custom}>
  <Fragment set:html={processedContent} />
</SiteLayout>
