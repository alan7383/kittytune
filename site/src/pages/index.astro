---
import SiteLayout from '../layouts/SiteLayout.astro';
import { PAGES } from '../config/site';
import ExpressiveCard from '../components/ExpressiveCard.astro';
import ShowcaseRow from '../components/ShowcaseRow.astro';
import PhilosophyItem from '../components/PhilosophyItem.astro';
import SectionHeader from '../components/SectionHeader.astro';
---

<SiteLayout page={PAGES.home}>
  <section class="avium-hero-section">
    <div class="avium-hero-container">
      <div class="avium-hero-left">
        <h1 class="avium-hero-title">KittyTune</h1>
        <p class="avium-hero-desc">
          SoundCloud and YouTube in one player, with real-time audio effects and zero ads. Material 3 Expressive, because why not.
          <span style="white-space: nowrap;">(^・ω・^ )</span>
        </p>
        <div class="avium-hero-buttons">
          <a href="#" class="latest-download-link avium-btn-download">
            Download
          </a>
          <a href="https://github.com/alan7383/kittytune" target="_blank" class="avium-btn-outline">
            <span class="material-icons-round">code</span> Source
          </a>
        </div>
      </div>
      <div class="avium-hero-right">
        <img src={`${import.meta.env.BASE_URL}assets/images/home.BY0cCzCQ.png`} alt="KittyTune Preview" class="avium-hero-img" />
      </div>
    </div>
  </section>
  <div class="container">
    <section class="features-section">
      <SectionHeader 
        title="Why KittyTune?" 
        description="For people who find Spotify's 30-second ads physically painful." 
        class="headline-large"
      />
      <div class="expressive-grid">
        <ExpressiveCard 
          span="8" 
          variant="primary" 
          delay="1" 
          kaomoji="( ^-^)~" 
          icon="tune" 
          title="Real-time Sound FX" 
          description="Nightcore, 8D Audio, pitch shifting, bass boost... you name it. Tweak everything on the fly while your track is playing. It just works." 
        />
        <ExpressiveCard 
          span="4" 
          variant="secondary" 
          delay="2" 
          kaomoji="(-_-) zzZ" 
          icon="lyrics" 
          title="Synced Lyrics" 
          description="Real-time lyrics straight from LrcLib. No manual sync needed." 
        />
        <ExpressiveCard 
          span="4" 
          variant="tertiary" 
          delay="1" 
          kaomoji="( o_O)?" 
          icon="hub" 
          title="Hybrid Playback" 
          description="SoundCloud blocked a track? KittyTune silently falls back to YouTube. You won't even notice." 
        />
        <ExpressiveCard 
          span="8" 
          variant="primary" 
          delay="2" 
          kaomoji="d(-_-)b" 
          icon="emoji_events" 
          title="RPG-style Progression" 
          description="Earn XP by listening, level up your profile, and collect badges like 'Night Owl' or 'Obsessed'. Because why not make music fun." 
        />
        <ExpressiveCard 
          span="6" 
          variant="secondary" 
          delay="1" 
          kaomoji="(=^.^=)" 
          icon="widgets" 
          title="Living Widgets" 
          description="Home screen widgets that adapt to your wallpaper palette. Looks native, feels native." 
        />
        <ExpressiveCard 
          span="6" 
          variant="tertiary" 
          delay="2" 
          kaomoji="(~_~;)" 
          icon="sync" 
          title="Full SoundCloud Sync" 
          description="Log in with your SoundCloud account. Playlists, likes, history, everything syncs. Zero telemetry, zero data harvesting. Promise." 
        />
      </div>
    </section>
  </div>

  <section class="showcase-section">
    <div class="container">
      <ShowcaseRow 
        step="01" 
        title="Material You, for real." 
        description="Colors pulled straight from your wallpaper. The whole UI adapts to your vibe, clean, spacious, and native to Android 12+. No weird third-party look." 
        highlight="#DynamicColors" 
        badgeIcon="palette" 
        badgeText="( ✯◡✯ )" 
        variant="1" 
        image="https://i.postimg.cc/FHZ4YvsR/Screenshot_20260208_152429.png" 
      />
      <ShowcaseRow 
        step="02" 
        title="Audio, your way." 
        description="Speed, pitch, 8D Audio, bass boost, all accessible from the player drawer. Mess around with it, find your sweet spot." 
        highlight="#PowerUser" 
        badgeIcon="equalizer" 
        badgeText="〜(￣▽￣〜)" 
        variant="2" 
        image="https://i.postimg.cc/g2DWxpky/Screenshot_20260208_152435.png" 
        reverse={true} 
      />
      <ShowcaseRow 
        step="03" 
        title="Lyrics that follow along." 
        description="Time-synced lyrics, scrolling in real-time. Missing from the database? Search and load your own LRC file. Simple." 
        highlight="#KaraokeMode" 
        badgeIcon="mic_external_on" 
        badgeText="(*´○`)o¶♪" 
        variant="3" 
        image="https://i.postimg.cc/Sxrhn4NW/Screenshot_20260208_152444.png" 
      />
      <ShowcaseRow 
        step="04" 
        title="Your profile, evolving." 
        description="Listening stats, XP, unlockable badges. It started as a joke feature and ended up being one of my favorites." 
        highlight="#LevelUp" 
        badgeIcon="star" 
        badgeText="(ﾉ◕ヮ◕)ﾉ*:･ﾟ✧" 
        variant="4" 
        image="https://i.postimg.cc/cLmSvW4w/Screenshot_20260208_152458.png" 
        reverse={true} 
      />
    </div>
  </section>
  <section class="philosophy-section">
    <div class="container">
      <div class="philosophy-header reveal">
        <div class="philosophy-badge">
          <span class="material-icons-round text-sm">public</span>
          100% Free & Open Source
        </div>
        <h2>No Ads. No Trackers.<br />Just Music.</h2>
        <p class="philosophy-desc">
          KittyTune is a side project I use every day. No ads, no trackers, no analytics. Just the app. Everything you need, nothing you don't.
        </p>
        <a href="https://github.com/alan7383/kittytune" class="btn btn-primary philosophy-github-btn">
          <span class="material-icons-round">star</span>
          Star on GitHub
        </a>
      </div>
      <div class="philosophy-wrapper">
        <div class="philosophy-grid">
          <PhilosophyItem 
            delay="1" 
            icon="shield_person" 
            title="Privacy First" 
            description="Minimal permissions. What you listen to stays locally on your device. Period." 
            color="var(--md-sys-color-primary)"
          />
          <PhilosophyItem 
            delay="2" 
            icon="translate" 
            title="Community Driven" 
            description='Available in multiple languages. Missing yours? Help us <span class="text-link">translate KittyTune</span> on Crowdin.' 
            color="var(--md-sys-color-tertiary)" 
            href="https://crowdin.com/project/kittytune"
          />
          <PhilosophyItem 
            delay="3" 
            icon="palette" 
            title="Material You" 
            description="Dynamic Colors, smooth transitions, and proper surface layers that follow Android 12+ conventions." 
            color="var(--md-sys-color-secondary)"
          />
          <PhilosophyItem 
            delay="4" 
            icon="code" 
            title="Open by Default" 
            description="GPL-3.0 licensed. Every line of code is public. You don't have to trust what the app says it does — you can verify it." 
            color="var(--md-sys-color-primary)"
          />
        </div>
      </div>
    </div>
  </section>
</SiteLayout>
