---
import SiteLayout from '../layouts/SiteLayout.astro';
import { PAGES } from '../config/site';
---

<SiteLayout page={PAGES.home}>
  <section class="avium-hero-section">
    <div class="avium-hero-container">
      <div class="avium-hero-left">
        <h1 class="avium-hero-title">KittyTune</h1>
        <p class="avium-hero-desc">
          SoundCloud and YouTube in one player, with real-time audio effects and zero ads. Material 3 Expressive, because why not.
          <span style="white-space: nowrap;">(^・ω・^ )</span>
        </p>
        <div class="avium-hero-buttons">
          <a href="#" class="latest-download-link avium-btn-download">
            Download
          </a>
          <a href="https://github.com/alan7383/kittytune" target="_blank" class="avium-btn-outline">
            <span class="material-icons-round">code</span> Source
          </a>
        </div>
      </div>
      <div class="avium-hero-right">
        <img src={`${import.meta.env.BASE_URL}assets/images/home.BY0cCzCQ.png`} alt="KittyTune Preview" class="avium-hero-img" />
      </div>
    </div>
  </section>
  <div class="container">
    <section class="features-section">
      <div class="section-header reveal">
        <h2 class="headline-large">Why KittyTune?</h2>
        <p>For people who find Spotify's 30-second ads physically painful.</p>
      </div>
      <div class="expressive-grid">
        <div class="expressive-card span-8 variant-primary reveal reveal-delay-1">
          <div class="kaomoji-hero">( ^-^)~</div>
          <div class="card-content">
            <div class="card-icon"><span class="material-icons-round">tune</span></div>
            <h3>Real-time Sound FX</h3>
            <p>
              Nightcore, 8D Audio, pitch shifting, bass boost... you name it. Tweak everything on the
              fly while your track is playing. It just works.
            </p>
          </div>
        </div>
        <div class="expressive-card span-4 variant-secondary reveal reveal-delay-2">
          <div class="kaomoji-hero">(-_-) zzZ</div>
          <div class="card-content">
            <div class="card-icon"><span class="material-icons-round">lyrics</span></div>
            <h3>Synced Lyrics</h3>
            <p>Real-time lyrics straight from LrcLib. No manual sync needed.</p>
          </div>
        </div>
        <div class="expressive-card span-4 variant-tertiary reveal reveal-delay-1">
          <div class="kaomoji-hero">( o_O)?</div>
          <div class="card-content">
            <div class="card-icon"><span class="material-icons-round">hub</span></div>
            <h3>Hybrid Playback</h3>
            <p>
              SoundCloud blocked a track? KittyTune silently falls back to YouTube. You won't even
              notice.
            </p>
          </div>
        </div>
        <div class="expressive-card span-8 variant-primary reveal reveal-delay-2">
          <div class="kaomoji-hero">d(-_-)b</div>
          <div class="card-content">
            <div class="card-icon"><span class="material-icons-round">emoji_events</span></div>
            <h3>RPG-style Progression</h3>
            <p>
              Earn XP by listening, level up your profile, and collect badges like "Night Owl" or
              "Obsessed". Because why not make music fun.
            </p>
          </div>
        </div>
        <div class="expressive-card span-6 variant-secondary reveal reveal-delay-1">
          <div class="kaomoji-hero">(=^.^=)</div>
          <div class="card-content">
            <div class="card-icon"><span class="material-icons-round">widgets</span></div>
            <h3>Living Widgets</h3>
            <p>Home screen widgets that adapt to your wallpaper palette. Looks native, feels native.</p>
          </div>
        </div>
        <div class="expressive-card span-6 variant-tertiary reveal reveal-delay-2">
          <div class="kaomoji-hero">(~_~;)</div>
          <div class="card-content">
            <div class="card-icon"><span class="material-icons-round">sync</span></div>
            <h3>Full SoundCloud Sync</h3>
            <p>
              Log in with your SoundCloud account. Playlists, likes, history, everything syncs. Zero
              telemetry, zero data harvesting. Promise.
            </p>
          </div>
        </div>
      </div>
    </section>
  </div>
  <section class="showcase-section">
    <div class="container">
      <div class="showcase-row">
        <div class="text-col">
          <div class="step-number">01</div>
          <h3>Material You, for real.</h3>
          <p>
            Colors pulled straight from your wallpaper. The whole UI adapts to your vibe, clean,
            spacious, and native to Android 12+. No weird third-party look.
          </p>
          <div class="highlight">#DynamicColors</div>
        </div>
        <div class="showcase-image-wrapper">
          <div class="kaomoji-badge variant-1">
            <div class="badge-icon-circle">
              <span class="material-icons-round">palette</span>
            </div>
            <span class="badge-text">( ✯◡✯ )</span>
          </div>
          <div class="phone-mockup">
            <img src="https://i.postimg.cc/FHZ4YvsR/Screenshot_20260208_152429.png" alt="UI Screenshot" />
          </div>
        </div>
      </div>
      <div class="showcase-row reverse">
        <div class="text-col">
          <div class="step-number">02</div>
          <h3>Audio, your way.</h3>
          <p>
            Speed, pitch, 8D Audio, bass boost, all accessible from the player drawer. Mess around with
            it, find your sweet spot.
          </p>
          <div class="highlight">#PowerUser</div>
        </div>
        <div class="showcase-image-wrapper">
          <div class="kaomoji-badge variant-2">
            <div class="badge-icon-circle">
              <span class="material-icons-round">equalizer</span>
            </div>
            <span class="badge-text">〜(￣▽￣〜)</span>
          </div>
          <div class="phone-mockup">
            <img src="https://i.postimg.cc/g2DWxpky/Screenshot_20260208_152435.png" alt="Audio Settings" />
          </div>
        </div>
      </div>
      <div class="showcase-row">
        <div class="text-col">
          <div class="step-number">03</div>
          <h3>Lyrics that follow along.</h3>
          <p>
            Time-synced lyrics, scrolling in real-time. Missing from the database? Search and load your
            own LRC file. Simple.
          </p>
          <div class="highlight">#KaraokeMode</div>
        </div>
        <div class="showcase-image-wrapper">
          <div class="kaomoji-badge variant-3">
            <div class="badge-icon-circle">
              <span class="material-icons-round">mic_external_on</span>
            </div>
            <span class="badge-text">(*´○`)o¶♪</span>
          </div>
          <div class="phone-mockup">
            <img src="https://i.postimg.cc/Sxrhn4NW/Screenshot_20260208_152444.png" alt="Lyrics Screen" />
          </div>
        </div>
      </div>
      <div class="showcase-row reverse">
        <div class="text-col">
          <div class="step-number">04</div>
          <h3>Your profile, evolving.</h3>
          <p>
            Listening stats, XP, unlockable badges. It started as a joke feature and ended up being one of my favorites.
          </p>
          <div class="highlight">#LevelUp</div>
        </div>
        <div class="showcase-image-wrapper">
          <div class="kaomoji-badge variant-4">
            <div class="badge-icon-circle">
              <span class="material-icons-round">star</span>
            </div>
            <span class="badge-text">(ﾉ◕ヮ◕)ﾉ*:･ﾟ✧</span>
          </div>
          <div class="phone-mockup">
            <img src="https://i.postimg.cc/cLmSvW4w/Screenshot_20260208_152458.png" alt="Profile Screen" />
          </div>
        </div>
      </div>
    </div>
  </section>
  <section class="philosophy-section">
    <div class="container">
      <div class="philosophy-header reveal">
        <div class="philosophy-badge">
          <span class="material-icons-round" style="font-size: 16px;">public</span>
          100% Free & Open Source
        </div>
        <h2>No Ads. No Trackers.<br />Just Music.</h2>
        <p class="philosophy-desc">
          KittyTune is a side project I use every day. No ads, no trackers, no analytics. Just the app. Everything you need, nothing you don't.
        </p>
        <a href="https://github.com/alan7383/kittytune" class="btn btn-primary philosophy-github-btn">
          <span class="material-icons-round">star</span>
          Star on GitHub
        </a>
      </div>
      <div class="philosophy-wrapper">
        <div class="philosophy-grid">
          <div class="philosophy-item reveal reveal-delay-1">
            <h4>
              <span class="material-icons-round" style="color: var(--md-sys-color-primary);">shield_person</span> Privacy First
            </h4>
            <p>Minimal permissions. What you listen to stays locally on your device. Period.</p>
          </div>
          <a href="https://crowdin.com/project/kittytune" target="_blank" rel="noopener noreferrer" class="philosophy-item reveal reveal-delay-2" style="text-decoration: none;">
            <h4>
              <span class="material-icons-round" style="color: var(--md-sys-color-tertiary);">translate</span> Community Driven
            </h4>
            <p>Available in multiple languages. Missing yours? Help us <span class="text-link">translate KittyTune</span> on Crowdin.</p>
          </a>
          <div class="philosophy-item reveal reveal-delay-3">
            <h4>
              <span class="material-icons-round" style="color: var(--md-sys-color-secondary);">palette</span> Material You
            </h4>
            <p>Dynamic Colors, smooth transitions, and proper surface layers that follow Android 12+ conventions.</p>
          </div>
          <div class="philosophy-item reveal reveal-delay-4">
            <h4>
              <span class="material-icons-round" style="color: var(--md-sys-color-primary);">code</span> Open by Default
            </h4>
            <p>GPL-3.0 licensed. Every line of code is public. You don't have to trust what the app says it does — you can verify it.</p>
          </div>
        </div>
      </div>
    </div>
  </section>
</SiteLayout>
