---
import SiteLayout from '../layouts/SiteLayout.astro';
import { PAGES } from '../config/site';
import MaterialSwitch from '../components/MaterialSwitch.astro';
import BentoPanel from '../components/BentoPanel.astro';
import FXCard from '../components/FXCard.astro';
import M3Slider from '../components/M3Slider.astro';
import FXPlayer from '../components/FXPlayer.astro';
import '../styles/shared/home-audio.css';
import '../styles/pages/audio-fx.css';
---

<SiteLayout page={PAGES['audio-fx']}>
  <header class="fx-header">
    <h1>Audio & FX Engine</h1>
    <p>A completely custom ExoPlayer implementation. Alter speed, balance EQ, and spatialize sound with ZERO latency.</p>
  </header>
  <div class="bento-grid">
    <BentoPanel 
      title="Core FX Processors" 
      description="Direct PCM (16-bit) byte manipulation extending ExoPlayer's <code>BaseAudioProcessor</code>. Zero latency." 
      icon="tune" 
      iconColor="var(--md-sys-color-primary)"
      class="core-fx-panel flex-col"
    >
      <div class="core-fx-grid">
        <FXCard title="Bass Boost" description="Biquad Low Shelf filter at 100Hz." icon="bolt" iconColor="var(--md-sys-color-primary)" />
        <FXCard title="Muffled" description="Biquad Low Pass dynamic cutoff." icon="blur_on" iconColor="var(--md-sys-color-secondary)" />
        <FXCard title="Reverb" description="150ms Circular delay line buffer." icon="graphic_eq" iconColor="#6eb5ff" />
        <FXCard title="Earrape" description="Massive hard clipping gain *800f." icon="warning" iconColor="#ff5f56" />
      </div>
    </BentoPanel>

    <BentoPanel 
      title="8D Spatial" 
      description="An LFO oscillator wraps music dynamically." 
      icon="360" 
      iconColor="var(--md-sys-color-tertiary)"
      class="eightd-panel grid-span-5 flex-col"
    >
      <div class="radar-grid-bg"></div>
      <div class="radar-module eightd-radar-module flex items-center justify-center">
        <div class="radar-container" id="radar-container">
          <div class="radar-head" id="radar-head">( o_o )</div>
          <div class="radar-orbit" id="radar-orbit"><div class="radar-dot"></div></div>
        </div>
      </div>
      <div class="eightd-control-card">
        <M3Slider 
          id="speed-slider" 
          min={0} 
          max={1} 
          step={0.01} 
          value={0.5} 
          axis="speed" 
          label="LFO Orbit Speed" 
          icon="speed" 
          outputId="ui-speed-val" 
          containerClass="eightd-range" 
          containerId="lfo-slider-container"
          aria-label="8D LFO orbit speed"
        />
        <div class="eightd-readout">
          <div class="eightd-readout-item">
            <span>Orbit loop</span>
            <strong id="orbit-duration-val">2.25s</strong>
          </div>
          <div class="eightd-readout-item">
            <span>Speed amount</span>
            <strong id="speed-amount-val">50%</strong>
          </div>
        </div>
      </div>
    </BentoPanel>

    <BentoPanel class="live-code-block grid-span-7">
      <div slot="header" class="code-controls">
        <div>
          <h3 class="panel-title"><span class="material-icons-round" style="color: #ffbd2e;">terminal</span> DSP Algorithms</h3>
          <p class="panel-desc">The Kotlin math responding to the 8D slider in real time.</p>
        </div>
        <div class="code-sync-card">
          <span class="material-icons-round">speed</span>
          <div class="code-sync-copy">
            <span>Live param</span>
            <strong id="code-speed-chip">0.50f</strong>
          </div>
        </div>
      </div>
        <div class="code-ide-pane">
        <div class="ide-tabs">
          <button class="ide-tab active" data-tab="8d">Spatialization (8D)</button>
          <button class="ide-tab" data-tab="biquad">Biquad Filter</button>
          <button class="ide-tab" data-tab="reverb">Delay Line</button>
          <button class="ide-tab" data-tab="muffled">Low-Pass</button>
        </div>
        <div class="code-scroll-container font-fira text-sm" id="code-display" style="line-height: 1.7; color: #abb2bf;">
        </div>
      </div>
    </BentoPanel>

    <BentoPanel 
      class="grid-span-12 p-12"
    >
      <div class="deep-dive-grid grid grid-cols-2 gap-12 items-center">
        <div>
          <h3 class="panel-title"><span class="material-icons-round" style="color: var(--md-sys-color-secondary);">memory</span> Bypassing Android's Audio Limits</h3>
          <p class="panel-desc max-w-100 mb-20">
            Standard Android audio effects like <code>android.media.audiofx</code> are applied at the OS level. That means a bass boost can sound completely different on a Samsung device compared to a Xiaomi or a Pixel, because each OEM can alter the underlying DSP.
          </p>
          <p class="panel-desc max-w-100 mb-6">
            <b>KittyTune fixes this.</b> By hooking directly into ExoPlayer's <code>DefaultAudioSink</code> via a custom <code>BaseAudioProcessor</code>, the app manipulates the raw 16-bit PCM <code>ByteBuffer</code> before it reaches Android AudioTrack.
            That keeps KittyTune's DSP signature consistent before hardware output on Samsung, Xiaomi, Pixel, and beyond. Biquad filters, LFO panning, and delay buffers stay as lightweight math on the audio thread, keeping the effect path under a millisecond for normal buffers without waking heavy OS DSP chains.
          </p>
          <div>
            <span class="tech-badge">inputAudioFormat.sampleRate</span>
            <span class="tech-badge">inputBuffer.getShort()</span>
            <span class="tech-badge">Math.sin() LFO</span>
            <span class="tech-badge">Biquad Filter</span>
            <span class="tech-badge">Direct Form II</span>
          </div>
        </div>
        <div class="pipeline-container">
          <div class="pipeline-step">
            <span class="material-icons-round step-icon">cloud_download</span>
            <div class="step-text">
              <h4>Media Source</h4>
              <p>SoundCloud Stream / Local MP3</p>
            </div>
          </div>
          <div class="pipeline-arrow"><span class="material-icons-round">arrow_downward</span></div>
          <div class="pipeline-step">
            <span class="material-icons-round step-icon">memory</span>
            <div class="step-text">
              <h4>ExoPlayer Decoders</h4>
              <p>Decodes to raw PCM 16-bit</p>
            </div>
          </div>
          <div class="pipeline-arrow"><span class="material-icons-round">arrow_downward</span></div>
          <div class="pipeline-step step-highlight">
            <span class="material-icons-round step-icon">graphic_eq</span>
            <div class="step-text">
              <h4>KittyTune DSP (AudioProcessors.kt)</h4>
              <p>Byte manipulation & Math formulas</p>
            </div>
          </div>
          <div class="pipeline-arrow"><span class="material-icons-round">arrow_downward</span></div>
          <div class="pipeline-step">
            <span class="material-icons-round step-icon">speaker</span>
            <div class="step-text">
              <h4>Android AudioTrack</h4>
              <p>OS playback via hardware</p>
            </div>
          </div>
        </div>
      </div>
    </BentoPanel>

    <BentoPanel 
      title="Live Effects Tester" 
      description="Experience the DSP effects in real-time. Turn on the switches to apply effects to the playback directly using the Web Audio API." 
      icon="play_circle" 
      iconColor="var(--md-sys-color-primary)"
      class="" 
      style="grid-column: span 12; padding: 48px;"
    >
      <FXPlayer />
    </BentoPanel>

    <BentoPanel id="rain-panel" class="rain-panel-layout grid-span-12">
      <div class="rain-bg"></div>
      <div class="z-2 max-w-500">
        <h3 class="panel-title"><span class="material-icons-round text-tertiary">water_drop</span> RainPlayer Ambience</h3>
        <p class="panel-desc mb-0">Layer high-fidelity rain noise entirely detached from the main music stream. Perfect for deep focus.</p>
      </div>
      <div class="rain-kaomoji" id="rain-face">[ /// ]</div>
      <button class="kt-btn-outline rain-toggle-btn z-2" id="rain-btn">
        Mix Ambience
      </button>
    </BentoPanel>
  </div>
</SiteLayout>

<script>
  import '../scripts/audio-engine.ts';
</script>
